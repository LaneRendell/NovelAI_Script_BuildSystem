{
  "name": "nibs-cli",
  "version": "4.3.0",
  "description": "Project build tool for NovelAI scripts - bundles TypeScript files into single scripts",
  "bin": {
    "nibs": "dist/cli.js"
  },
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsc && node scripts/copy-assets.mjs",
    "gen:icon-types": "tsx scripts/gen-icon-types.ts",
    "format": "prettier . -w",
    "typecheck": "tsc --noEmit",
    "help": "node src/cli.ts --help",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">= 18"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/rollup": "^0.51.4",
    "tsx": "^4.22.4",
    "typescript": "^5.3.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "commander": "^14.0.2",
    "feather-icons": "^4.29.2",
    "inquirer": "^13.0.2",
    "prettier": "^3.7.4",
    "rollup": "^4.59.0",
    "yaml": "^2.8.2"
  },
  "repository": {
    "url": "https://github.com/LaneRendell/NovelAI_Script_BuildSystem"
  }
}
